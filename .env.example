# ---------------------------------------------------------------------------
# Home Cost Australia — environment variables
# Copy to .env.local and fill in real values. Nothing here contains secrets.
# The site builds and runs with every value blank: ads/analytics degrade to
# "disabled" cleanly. See README.md for the full guide.
# ---------------------------------------------------------------------------

# Canonical PRODUCTION origin (no trailing slash). Used for every indexable
# URL: canonicals, sitemap, robots and Open Graph — even on staging.
NEXT_PUBLIC_SITE_URL=https://example.com

# Deployment environment. Leave unset on Vercel (inferred from VERCEL_ENV).
# Set to "production" only on the real production deployment. Any other value —
# or an unset value on a non-production deploy — makes the whole site
# noindex,nofollow so staging never competes in Search.
# NEXT_PUBLIC_SITE_ENV=production

# Provisional public brand name (working name only).
NEXT_PUBLIC_SITE_NAME="Home Cost Australia"

# Google AdSense publisher client, e.g. ca-pub-XXXXXXXXXXXXXXXX.
# The site's real publisher id is baked into config as the default; set this
# only to override it. The account/verification loader script (adsbygoogle.js)
# loads on non-development deployments so Google can verify the site. Ad UNITS
# stay off until NEXT_PUBLIC_ADSENSE_ENABLED=true (see below).
NEXT_PUBLIC_ADSENSE_CLIENT=

# Master switch for AdSense. Must be "true" AND a real client above for ads to
# render in production. Defaults to disabled.
NEXT_PUBLIC_ADSENSE_ENABLED=false

# Show discreet ad *placeholders* in development only (never live ads).
NEXT_PUBLIC_SHOW_AD_PLACEHOLDERS=false

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX. Blank = analytics off.
# (Analytics only load in production, after consent.)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Set "true" only once a CERTIFIED CMP (e.g. Google Privacy & Messaging) is
# connected for EEA/UK/Switzerland ad consent. Never label the built-in banner
# as certified.
NEXT_PUBLIC_CMP_ENABLED=false

# Google Search Console verification token (the content= value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Public contact email shown on the Contact page and used in schema.
NEXT_PUBLIC_CONTACT_EMAIL=

# Legal entity that owns/operates the site. Required before production launch.
PUBLISHER_LEGAL_NAME=

# Prelaunch strictness. When "true", prelaunch:check fails if placeholders or
# example.com remain. Keep false for local/preview work.
REQUIRE_LEGAL_COMPLETE=false
PRELAUNCH_STRICT=false
